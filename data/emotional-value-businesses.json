  "ppmtAudit": {
    "title": "PPMT：这个感知走到数据里，还剩下什么？",
    "summary": "最强证据不是营收暴涨，而是三件事同时发生：老用户回流变强、消费载体从手办迁移到毛绒、每一元收入对应的广义销售费用下降。最强反证则是增长高度集中在 THE MONSTERS。",
    "tests": [
      {
        "id": "return-test",
        "label": "用户真的回来了吗？",
        "verdict": "支持",
        "tone": "support",
        "strength": "直接经营指标",
        "finding": "会员复购率从 49.4% 升至 55.7%，会员销售贡献从 92.7% 升至 93.7%。会员池从 4,608 万增至 7,258 万。",
        "interpretation": "用户回流与会员依赖同步增强，符合“第一次交易之后还有交易”。",
        "alternative": "复购可能来自盲盒概率机制、限量发行或新品密度，财报没有按 IP 和获客年份给出 cohort。",
        "sourceRefs": [
          {
            "sourceId": "popmart-2025-ar",
            "page": 17
          },
          {
            "sourceId": "popmart-2024-results",
            "page": 22
          }
        ]
      },
      {
        "id": "extension-test",
        "label": "盲盒之后还能卖什么？",
        "verdict": "较强支持",
        "tone": "support",
        "strength": "品类迁移指标",
        "finding": "毛绒收入从 28.32 亿元增至 187.08 亿元，同比增长 560.6%；收入占比从 21.7% 升至 50.4%，手办占比则从 53.2% 降至 32.4%。",
        "interpretation": "IP 已经跨过原始手办载体，毛绒更接近日常陪伴品，这与“进入生活”的感知高度一致。",
        "alternative": "无法证明毛绒购买者先买过盲盒；也可能是 LABUBU 毛绒带来的新客与新需求。",
        "sourceRefs": [
